{
  "name": "@zthun/lumberjacky",
  "description": "Logging system for use with node and websites.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/lumberjacky"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "logging"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "check": "tsc --noEmit",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@types/lodash": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@zthun/janitor-build-config": "^19.5.4",
    "@zthun/janitor-lint": "^19.5.4",
    "@zthun/janitor-lint-config": "^19.5.4",
    "@zthun/janitor-options": "^19.5.4",
    "@zthun/janitor-ts-config": "^19.5.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lerna": "^9.0.3",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "packageManager": "yarn@4.12.0"
}
