{
  "name": "@zthun/lumberjacky",
  "description": "Logging system for use with node and websites.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/lumberjacky"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "logging"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "lint": "lint-janitor",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.14.11",
    "@vitest/coverage-istanbul": "^2.0.4",
    "@zthun/lint-janitor": "^16.1.1",
    "@zthun/lint-janitor-config": "^16.1.1",
    "husky": "^9.1.1",
    "jsdom": "^24.1.1",
    "lerna": "^8.1.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^2.0.4"
  },
  "packageManager": "yarn@4.3.1"
}
