{
  "name": "@zthun/lumberjacky",
  "description": "Logging system for use with node and websites.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/lumberjacky"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "logging"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "test": "vitest --run --coverage",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/lodash": "^4.17.17",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.30",
    "@vitest/coverage-istanbul": "^3.2.3",
    "@zthun/janitor-build-config": "^19.1.5",
    "@zthun/janitor-lint": "^19.1.5",
    "@zthun/janitor-lint-config": "^19.1.5",
    "@zthun/janitor-options": "^19.1.5",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lerna": "^8.2.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "resolutions": {
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.6.0"
}
